---
/**
 * A wrong URL should still land somewhere useful. This offers the two doors
 * rather than an apology.
 */
import Base from "../layouts/Base.astro";
import { THEMES, byTheme } from "../lib/content";
import T from "../components/T.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// A few of the most-populated themes, as somewhere to go next.
const suggestions = [...THEMES].sort((a, b) => byTheme(b.id).length - byTheme(a.id).length).slice(0, 4);
---

<Base title="Not found — The Duʿāʾ of the Prophets" description="That page does not exist.">
  <h1 style="font-size: var(--t-xl); margin-top: var(--s-16)">That page isn’t here.</h1>
  <p class="lede" style="margin-top: var(--s-4)">
    The link may be out of date, or the address mistyped. Everything on the site
    is reachable from one of these.
  </p>

  <div class="stack" style="margin-top: var(--s-8)">
    <p style="font-family: var(--font-util)">
      <a href={`${base}/themes/`} data-i18n="navNeed">By need</a> ·
      <a href={`${base}/prophets/`} data-i18n="navProphets">Prophets</a> ·
      <a href={`${base}/search/`} data-i18n="navSearch">Search</a>
    </p>

    <ul class="themes">
      {
        suggestions.map((t) => (
          <li>
            <a class="theme-link" href={`${base}/themes/${t.id}/`}>
              <span class="theme-name">
                <T en={t.label.en} tr={t.label.tr} />
              </span>
              <span class="theme-count">{byTheme(t.id).length} duʿāʾ</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
