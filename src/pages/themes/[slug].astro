---
import Base from "../../layouts/Base.astro";
import InlineDua from "../../components/InlineDua.astro";
import T from "../../components/T.astro";
import { THEMES, byTheme, prophet, refLabel } from "../../lib/content";

export function getStaticPaths() {
  return THEMES.map((t) => ({ params: { slug: t.id }, props: { theme: t } }));
}

const { theme } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const duas = byTheme(theme.id);
const showJumpList = duas.length > 3;
---

<Base title={`${theme.label.en} — The Duʿāʾ of the Prophets`} description={theme.description.en}>
  <p class="kicker" style="margin-top: var(--s-12)">
    <a href={`${base}/themes/`} data-i18n="crumbThemes">I need words for…</a>
  </p>
  <h1 style="font-size: var(--t-xl); margin-top: var(--s-2); max-width: 22ch">
    <T en={theme.label.en} tr={theme.label.tr} />
  </h1>
  <p class="lede" style="margin-top: var(--s-4)">
    <T en={theme.description.en} tr={theme.description.tr} />
  </p>

  {
    showJumpList && (
      <nav class="jump" aria-label="Jump to a duʿāʾ">
        <ol>
          {duas.map((d, i) => (
            <li>
              <a href={`#${d.id}`}>
                <span class="seq-num">{i + 1}</span>
                {d.title.en}
                <span class="jump-ref">{prophet(d.speaker)?.name.en}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <div class="dua-flow">
    {
      duas.map((d, i) => (
        <InlineDua
          dua={d}
          index={duas.length > 1 ? i + 1 : undefined}
          showSpeaker={prophet(d.speaker)?.name.en}
        />
      ))
    }
  </div>
</Base>
