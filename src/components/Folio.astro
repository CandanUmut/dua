---
/**
 * The illuminated frame the Arabic sits in: a tezhip band of chained stars
 * with rosette corners (a CSS border-image drawn in src/lib/geometry.ts), an
 * inner gilt rule, and a lapis cartouche at the head carrying the star.
 */
import { starPath } from "../lib/geometry";
interface Props { foot?: string; class?: string }
const { foot, class: cls } = Astro.props;
---

<div class:list={["folio", cls]}>
  <span class="crest" aria-hidden="true">
    <svg viewBox="-12 -12 24 24" width="24" height="24">
      <path d={starPath(8, 3, 10, 0, 0, -Math.PI / 2 + Math.PI / 8)} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      <circle r="2.2" fill="currentColor" />
    </svg>
  </span>
  <div class="folio-in">
    <slot />
    {foot && <p class="folio-foot">{foot}</p>}
  </div>
</div>
