---
/**
 * A duʿāʾ in full, in a list of others — prophet, theme and moment pages carry
 * every passage inline so a reader can scroll straight through. The depth
 * (commentary, reflection, related) stays on the duʿāʾ's own page.
 */
import Passage from "./Passage.astro";
import type { Dua } from "../../content/schema";
import { duaUrl, name, prophet } from "../lib/content";
import { pick, t, type Lang } from "../lib/i18n";

interface Props { dua: Dua; lang: Lang; showSpeaker?: boolean }
const { dua, lang, showSpeaker = false } = Astro.props;
const occasion = pick(dua.context.summary, lang);
---

<article class="inline-dua" id={dua.id}>
  <h2><a href={duaUrl(lang, dua.id)}>{pick(dua.title, lang)}</a></h2>
  {showSpeaker && <p class="meta">{name(prophet(dua.speaker), lang)}</p>}
  <Passage dua={dua} lang={lang} compact />
  {occasion && <p class="occ">{occasion}</p>}
  <p class="util small" style="margin-top: var(--s-3)">
    <a href={duaUrl(lang, dua.id)}>{t("moreOnPage", lang)} →</a>
  </p>
</article>
