---
/** A rule with a knot of three stars at its centre, between sections. */
import { starPath } from "../lib/geometry";
const s = (x: number, r: number) => starPath(8, 3, r, x, 10, -Math.PI / 2 + Math.PI / 8);
---

<div class="rule" aria-hidden="true">
  <svg viewBox="0 0 80 20" width="80" height="20">
    <g fill="var(--paper)" stroke="var(--gilt)" stroke-width="1" stroke-linejoin="round">
      <path d={s(22, 5)} /><path d={s(58, 5)} /><path d={s(40, 9)} />
    </g>
    <circle cx="40" cy="10" r="2" fill="var(--rubric)" />
  </svg>
</div>
