---
/**
 * A duʿāʾ passage: the Arabic in its folio, the transliteration, the
 * translations, and the source apparatus beneath.
 *
 * On a Qurʾānic excerpt the whole āyah is shown with the supplication in full
 * ink and the narrative framing dimmed, because the translations render the
 * complete āyah: nine words of Arabic beside forty of English would quietly
 * imply they say the same thing.
 *
 * Translators are credited once, in the apparatus — not over every block,
 * where a name read as a byline on the duʿāʾ itself.
 */
import type { Dua } from "../../content/schema";
import Folio from "./Folio.astro";
import { fullRef } from "../lib/content";
import { t, type Lang } from "../lib/i18n";

interface Props {
  dua: Dua;
  lang: Lang;
  /** On pages of many passages, show only the source line. */
  compact?: boolean;
}
const { dua, lang, compact = false } = Astro.props;
const src = dua.source;
const excerpt = src.type === "quran" ? src.excerpt : undefined;
const order = lang === "tr" ? ["tr", "en"] : ["en", "tr"];
const translations = order
  .map((l) => dua.translations.find((x) => x.lang === l))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));
const langName = (l: string) => t(l === "en" ? "langEn" : "langTr", lang);

let before = "";
let core = dua.arabic?.text ?? "";
let after = "";
if (excerpt && dua.arabic?.fullText) {
  const words = dua.arabic.fullText.split(" ");
  before = words.slice(0, excerpt.fromWord).join(" ");
  core = words.slice(excerpt.fromWord, excerpt.toWord).join(" ");
  after = words.slice(excerpt.toWord).join(" ");
}
const GRADE_TR: Record<string, string> = { "ṣaḥīḥ": "sahih", "ḥasan": "hasen", "ḥasan ṣaḥīḥ": "hasen sahih" };
const GRADER_TR: Record<string, string> = { "al-Bukhārī": "Buhârî", Muslim: "Müslim", "al-Albānī": "Elbânî" };
const grade = src.type === "hadith"
  ? lang === "tr"
    ? `${GRADE_TR[src.grading] ?? src.grading} — ${GRADER_TR[src.gradedBy] ?? src.gradedBy}`
    : `${src.grading} — ${src.gradedBy}`
  : "";
const quranLink =
  src.type === "quran" ? `https://quran.com/${src.ayat[0].surah}/${src.ayat[0].ayah}` : undefined;
---

<div class="passage">
  <div>
    <Folio foot={fullRef(dua, lang)}>
      <p class="arabic" lang="ar" dir="rtl" translate="no" data-arabic>
        {before && <span class="ar-frame">{before} </span>}
        <span class="ar-core">{core}</span>
        {after && <span class="ar-frame"> {after}</span>}
      </p>
      {dua.transliteration && <p class="translit" translate="no">{dua.transliteration.text}</p>}
    </Folio>

    {
      translations.map((tr) => (
        <div class="translation" data-lang={tr.lang} translate="no">
          <span class="translation-by" lang={lang}>{langName(tr.lang)}</span>
          <p lang={tr.lang}>{tr.text}</p>
        </div>
      ))
    }
  </div>

  {
    !compact && (
      <dl class="apparatus" aria-label={t("secSource", lang)}>
        <dt>{t("secSource", lang)}</dt>
        <dd>
          {src.type === "quran" ? (
            <a href={quranLink} rel="noreferrer">{fullRef(dua, lang)}</a>
          ) : src.type === "hadith" ? (
            <a href={src.url} rel="noreferrer">{fullRef(dua, lang)}</a>
          ) : (
            <>{src.work}, {src.locus}</>
          )}
        </dd>

        {src.type === "hadith" && (
          <>
            <dt>{t("secGrading", lang)}</dt>
            <dd>{grade}</dd>
          </>
        )}

        {(excerpt || src.type === "hadith") && (
          <>
            <dt>{t("secExtent", lang)}</dt>
            <dd>{t(excerpt ? "extentNote" : "extentHadith", lang)}</dd>
          </>
        )}

        <dt>{t("secTranslation", lang)}</dt>
        <dd>
          {translations.map((tr, i) => (
            <>
              {i > 0 && <br />}
              {langName(tr.lang)}:{" "}
              {tr.project ? t(tr.draft ? "creditDraft" : "creditProject", lang) : tr.translator}
            </>
          ))}
        </dd>
      </dl>
    )
  }
</div>
