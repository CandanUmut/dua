---
/**
 * The duʿāʾ passage: Arabic, transliteration, translations — with the source
 * apparatus set as a marginal rubric beside it (DESIGN.md §3).
 *
 * On excerpts, this renders the **whole āyah** with the supplication in full
 * ink and the surrounding narrative dimmed, rather than the excerpt alone. That
 * is a correctness decision: the translations render the complete āyah, so an
 * excerpt-only Arabic would put nine words of Arabic beside forty of English
 * and quietly imply they said the same thing.
 *
 * Entries whose source is `attributed` — currently only Dāwūd's psalm — have no
 * Arabic at all, and say so loudly rather than quietly omitting the block.
 */
import type { Dua } from "../../content/schema";
import { refLabel } from "../lib/content";

interface Props {
  dua: Dua;
}
const { dua } = Astro.props;

const src = dua.source;
const excerpt = src.type === "quran" ? src.excerpt : undefined;

/** All renderings, grouped — an entry may carry two Turkish translations. */
const en = dua.translations.filter((t) => t.lang === "en");
const tr = dua.translations.filter((t) => t.lang === "tr");

const LANG_LABEL: Record<string, string> = { en: "English", tr: "Türkçe" };

/**
 * Split the full āyah into [before, supplication, after] on the recorded word
 * boundaries. Pure slicing of fetched text — nothing is rewritten.
 */
let before = "";
let core = dua.arabic?.text ?? "";
let after = "";
if (excerpt && dua.arabic?.fullText) {
  const words = dua.arabic.fullText.split(" ");
  before = words.slice(0, excerpt.fromWord).join(" ");
  core = words.slice(excerpt.fromWord, excerpt.toWord).join(" ");
  after = words.slice(excerpt.toWord).join(" ");
}
---

<div class="passage">
  <dl class="apparatus" aria-label="Source">
    <dt>Source</dt>
    <dd>
      {
        src.type === "quran" ? (
          <>
            Sūrat {src.surahName}
            <br />
            <a href={`https://quran.com/${src.ayat[0].surah}/${src.ayat[0].ayah}`} rel="noreferrer">
              {refLabel(dua)}
            </a>
          </>
        ) : src.type === "hadith" ? (
          <>
            {src.collection}
            <br />
            <a href={src.url} rel="noreferrer">
              no. {src.number}
            </a>
          </>
        ) : (
          <>
            {src.work}
            <br />
            {src.locus}
          </>
        )
      }
    </dd>

    {
      src.type === "hadith" && (
        <>
          <dt>Grading</dt>
          <dd>
            {src.grading} — {src.gradedBy}
          </dd>
        </>
      )
    }

    {
      src.type === "attributed" && (
        <>
          <dt>Status</dt>
          <dd>Outside the Qurʾān and Sunnah</dd>
        </>
      )
    }

    {
      excerpt && (
        <>
          <dt>Extent</dt>
          <dd>Excerpt within the āyah, shown in full ink against dimmed framing.</dd>
        </>
      )
    }

    {
      src.type === "quran" && (
        <>
          <dt>Text</dt>
          <dd>Uthmani, verified by checksum</dd>
        </>
      )
    }
  </dl>

  <div class="passage-body">
    {
      dua.arabic ? (
        /*
          lang and dir go on this node specifically, never on <html>.
          translate="no" keeps Chrome from re-translating vetted scripture.
        */
        <p class="arabic" lang="ar" dir="rtl" translate="no">
          {before && <span class="ar-frame">{before} </span>}
          <span class="ar-core">{core}</span>
          {after && <span class="ar-frame"> {after}</span>}
        </p>
      ) : (
        <p class="notice" style="margin-top:0">
          No Arabic original — this passage is not Qurʾānic.
        </p>
      )
    }

    {
      dua.transliteration && (
        <p class="translit" data-translit-block translate="no">
          {dua.transliteration.text}
        </p>
      )
    }

    {
      /*
        `lang` goes on the text itself, not the wrapper. Putting it on the
        wrapper made the label inherit it, and `text-transform: uppercase`
        under lang="tr" applies Turkish casing — so "PROJECT TRANSLATION"
        rendered as "PROJECT TRANSLATİON".
      */
      [...en, ...tr].map((t) => (
        <div class="translation" data-lang={t.lang} translate="no">
          <span class="translation-by" lang="en">
            {LANG_LABEL[t.lang] ?? t.lang} · {t.draft ? "unreviewed project draft" : t.translator}
          </span>
          <span lang={t.lang}>{t.text}</span>
        </div>
      ))
    }
  </div>
</div>
