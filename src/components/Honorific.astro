---
/**
 * Renders a figure's honorific in the form the reader has chosen.
 *
 * All three forms ship in data attributes and the settings script swaps the
 * text content, so the choice works without a round trip and the honorific is
 * never baked into a name string (brief §2.5).
 */
import { HONORIFICS } from "../lib/content";
import type { Honorific } from "../../content/schema";

interface Props {
  honorific: Honorific;
}
const { honorific } = Astro.props;
const h = HONORIFICS[honorific];
---

{
  h.arabic && (
    <span
      class="honorific"
      data-hon
      data-hon-arabic={h.arabic}
      data-hon-full={h.full}
      data-hon-abbr={h.abbr}
      lang={honorific === "sallallahu-alayhi-wa-sallam" ? undefined : "ar"}
      dir={honorific === "sallallahu-alayhi-wa-sallam" ? undefined : "rtl"}
      translate="no"
      aria-label={h.full}
    >
      {h.arabic}
    </span>
  )
}
