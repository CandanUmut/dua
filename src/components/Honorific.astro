---
/**
 * A figure's honorific in the form the reader has chosen. All three forms ship
 * as data attributes; the settings script swaps the text, so the choice works
 * without a reload and the honorific is never baked into a name.
 */
import { HONORIFICS } from "../lib/content";
import type { Honorific } from "../../content/schema";
import type { Lang } from "../lib/i18n";

interface Props { honorific: Honorific; lang: Lang }
const { honorific, lang } = Astro.props;
const h = HONORIFICS[honorific];
const isSaw = honorific === "sallallahu-alayhi-wa-sallam";
---

{
  h.arabic && (
    <span
      class="honorific"
      data-hon
      data-hon-arabic={h.arabic}
      data-hon-full={h.full[lang]}
      data-hon-abbr={h.abbr}
      lang={isSaw ? undefined : "ar"}
      dir={isSaw ? undefined : "rtl"}
      translate="no"
      aria-label={h.full[lang]}
      style="font-family: var(--font-arabic); font-weight: 400"
    >
      {h.arabic}
    </span>
  )
}
