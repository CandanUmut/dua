---
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
import { LEGACY_REDIRECTS } from "../lib/content";
import { alternate, t, url, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  ogType?: "website" | "article";
  /** Which tab is current. */
  tab?: "today" | "need" | "prophets" | "search" | "mine" | "about";
  /** Set on a duʿāʾ page, so it is recorded in "recently read". */
  duaId?: string;
}
const { lang, title, description, jsonLd, ogType = "article", tab, duaId } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const altEn = new URL(alternate(path, "en"), Astro.site).href;
const altTr = new URL(alternate(path, "tr"), Astro.site).href;
const other: Lang = lang === "en" ? "tr" : "en";
const ogImage = new URL(`${base}/og-image.png`, Astro.site).href;

const tabs = [
  { id: "today", href: url(lang, "/"), label: t("navToday", lang), icon: "today" },
  { id: "need", href: url(lang, "/themes/"), label: t("navNeed", lang), icon: "need" },
  { id: "prophets", href: url(lang, "/prophets/"), label: t("navProphets", lang), icon: "prophets" },
  { id: "search", href: url(lang, "/search/"), label: t("navSearch", lang), icon: "search" },
  { id: "mine", href: url(lang, "/mine/"), label: t("navMine", lang), icon: "mine" },
] as const;
const boot = { lang, base };
---

<!doctype html>
<html lang={lang} data-reading={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google" content="notranslate" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="tr" href={altTr} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t("siteName", lang)} />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_GB"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#e9e6de" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161816" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={lang === "tr" ? "Dualar" : "Duʿāʾ"} />
    <link rel="manifest" href={`${base}/${lang === "tr" ? "manifest-tr" : "manifest"}.webmanifest`} />
    <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/icon-180.png`} />
    <link rel="preload" href={`${base}/fonts/amiri-arabic-1.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/serif-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/sans-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/serif-latinext.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/sans-latinext.woff2`} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {/* Applied before first paint so theme and type size never flash. */}
    <script is:inline>
      (() => {
        try {
          const s = JSON.parse(localStorage.getItem("dua.settings") || "{}");
          const r = document.documentElement;
          if (s.theme && s.theme !== "auto") r.dataset.theme = s.theme;
          if (s.type && s.type !== "normal") r.dataset.type = s.type;
          if (s.translit === false) r.dataset.translit = "off";
          if (s.honorific) r.dataset.honorific = s.honorific;
          if (s.reading && s.reading !== "auto") r.dataset.reading = s.reading;
        } catch {}
      })();
    </script>
    <script is:inline set:html={`window.DUA=${JSON.stringify(boot)};`} />
    <script is:inline defer src={`${base}/strings/${lang}.js`}></script>
    <script is:inline defer src={`${base}/app.js`}></script>
  </head>
  <body data-dua-id={duaId}>
    <a class="skip" href="#main">{t("skip", lang)}</a>

    <header class="bar">
      <div class="bar-in">
        <a class="wordmark" href={url(lang, "/")}>
          <Mark size={28} />
          <span>{t("siteName", lang)}</span>
        </a>
        <nav class="bar-nav" aria-label="Primary">
          {tabs.slice(1).map((n) => (
            <a href={n.href} aria-current={tab === n.id ? "page" : undefined}>{n.label}</a>
          ))}
          <a href={url(lang, "/about/")} aria-current={tab === "about" ? "page" : undefined}>{t("navAbout", lang)}</a>
        </nav>
        <div class="bar-tools">
          <a
            class="icon-btn lang-switch"
            href={alternate(path, other)}
            hreflang={other}
            lang={other}
            data-set-lang={other}
            aria-label={t("otherLangLabel", lang)}
          >{other.toUpperCase()}</a>
          <button class="icon-btn" type="button" data-open-settings aria-haspopup="dialog" aria-label={t("navSettings", lang)}>
            <Icon name="settings" />
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="foot">
      <div class="page">
        <p>{t("footText", lang)}</p>
        <p>{t("footPrivacy", lang)}</p>
        <p>
          <a href={url(lang, "/about/")}>{t("navAbout", lang)}</a> ·
          <a href={url(lang, "/day/")}>{t("navDay", lang)}</a> ·
          <a href="https://github.com/CandanUmut/dua/issues/new" rel="noreferrer">{t("actReport", lang)}</a>
        </p>
      </div>
    </footer>

    <nav class="tabs" aria-label="Primary">
      <ul>
        {tabs.map((n) => (
          <li>
            <a href={n.href} aria-current={tab === n.id ? "page" : undefined}>
              <Icon name={n.icon} />
              <span>{n.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <dialog class="sheet" data-settings aria-labelledby="settings-title">
      <h2 id="settings-title">{t("settingsTitle", lang)}</h2>
      {
        [
          ["reading", "setReading", [["auto", "setReadingAuto"], ["both", "setBoth"], ["en", "langEn"], ["tr", "langTr"]]],
          ["theme", "setAppearance", [["auto", "setAuto"], ["light", "setLight"], ["dark", "setDark"]]],
          ["type", "setTextSize", [["normal", "setNormal"], ["large", "setLarge"], ["xlarge", "setXLarge"]]],
          ["translit", "setTranslit", [["on", "setShow"], ["off", "setHide"]]],
          ["honorific", "setHonorifics", [["arabic", "setArabicForm"], ["full", "setEnglishForm"], ["abbr", "setAbbr"]]],
        ].map(([name, label, opts]) => (
          <div class="setting" role="radiogroup" aria-labelledby={`set-${name}`}>
            <span id={`set-${name}`}>{t(label as any, lang)}</span>
            <div class="choices">
              {(opts as string[][]).map(([v, k]) => (
                <label>
                  <input type="radio" name={name as string} value={v} />
                  <span>{t(k as any, lang)}</span>
                </label>
              ))}
            </div>
          </div>
        ))
      }
      <form method="dialog">
        <button class="btn primary">{t("setDone", lang)}</button>
      </form>
    </dialog>

    <dialog class="sheet" data-list-sheet aria-labelledby="list-title">
      <h2 id="list-title">{t("addToList", lang)}</h2>
      <ul class="check-list" data-list-options></ul>
      <div class="row">
        <button class="btn" type="button" data-new-list><Icon name="plus" />{t("newList", lang)}</button>
        <form method="dialog" style="margin-left:auto"><button class="btn primary">{t("setDone", lang)}</button></form>
      </div>
    </dialog>

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    {/* Old hash routes (#view=dua&id=…) live on in bookmarks and messages. */}
    <script is:inline define:vars={{ redirects: LEGACY_REDIRECTS, home: url(lang, "/") }}>
      (() => {
        const h = location.hash;
        if (!h || h.length < 2) return;
        const p = new URLSearchParams(h.slice(1));
        const view = p.get("view"), id = p.get("id");
        if (view === "dua" && id && redirects[id]) location.replace(home + "duas/" + redirects[id] + "/");
        else if (view === "prophets") location.replace(home + "prophets/");
        else if (view === "topics") location.replace(home + "themes/");
        else if (view === "about") location.replace(home + "about/");
      })();
    </script>
  </body>
</html>
