{
  "name": "prophets-dua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:fetch": "tsx scripts/fetch-content.ts",
    "content:verify": "tsx scripts/verify-content.ts && tsx scripts/fetch-hadith.ts --verify",
    "content:inventory": "tsx scripts/build-inventory.ts",
    "typecheck": "tsc --noEmit",
    "dev": "astro dev",
    "build": "astro build && tsx scripts/build-sitemap.ts && tsx scripts/build-sw.ts",
    "preview": "astro preview",
    "content:build": "tsx scripts/build-content.ts",
    "content:all": "tsx scripts/fetch-content.ts && tsx scripts/fetch-hadith.ts && tsx scripts/fetch-tafsir.ts && tsx scripts/migrate-legacy.ts && tsx scripts/build-content.ts",
    "prebuild": "npm run content:build",
    "content:fetch-tafsir": "tsx scripts/fetch-tafsir.ts",
    "content:fetch-quotes": "tsx scripts/fetch-quotes.ts",
    "check:arabic": "tsx scripts/check-no-typed-arabic.ts",
    "content:fetch-hadith": "tsx scripts/fetch-hadith.ts",
    "check:copy": "tsx scripts/check-copy.ts",
    "test:smoke": "node tests/smoke.mjs",
    "check": "npm run typecheck && npm run check:arabic && tsx scripts/check-coverage.ts && npm run build && npm run check:copy && npm run test:smoke"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "astro": "^5.18.2"
  }
}
